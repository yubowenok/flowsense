{
  "name": "flowsense",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/yubowenok/flowsense",
  "author": "Bowen Yu <yubowenok@gmail.com>",
  "private": true,
  "scripts": {
    "start": "yarn build && node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch-build": "tsc -w -p tsconfig.json",
    "watch-node": "nodemon --inspect dist/src/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"yarn watch-build\" \"yarn watch-node\"",
    "test": "jest --runInBand --detectOpenHandles",
    "watch-test": "jest --watch",
    "gen-templates": "yarn build && node dist/src/script/gen-templates.js",
    "similarity-server": "python3 src/script/similarity.py"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "errorhandler": "^1.5.2",
    "express": "^4.22.2",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "glob": "^13.0.6",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/serve-static": "^1.15.10"
  }
}
